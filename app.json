{
  "expo": {
    "name": "B'Smart Admin",
    "slug": "bsmartdress",
    "owner": "alexanderxs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fed73a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bsmart.admin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fed73a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://admin-app-backend-i5tk.onrender.com",
      "eas": {
        "projectId": "b4fa33b9-fbb3-41d3-a298-f04b7c57f9ed"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b4fa33b9-fbb3-41d3-a298-f04b7c57f9ed",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    }
  }
}
